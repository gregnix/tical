package require tcltest 2
namespace import tcltest::*

lappend auto_path [file normalize [file dirname [info script]]/..]
package require tical::config
package require tical::locale

test locale-1.1 {German month names long} -setup {
    tical::config::set locale de_DE
} -body {
    list [tical::locale::getMonthName 1] \
         [tical::locale::getMonthName 10] \
         [tical::locale::getMonthName 12]
} -result {Januar Oktober Dezember}

test locale-1.2 {German month names short} -setup {
    tical::config::set locale de_DE
} -body {
    list [tical::locale::getMonthName 1 short] \
         [tical::locale::getMonthName 10 short] \
         [tical::locale::getMonthName 12 short]
} -result {Jan Okt Dez}

test locale-1.3 {German weekday names long} -setup {
    tical::config::set locale de_DE
} -body {
    list [tical::locale::getWeekdayName 1] \
         [tical::locale::getWeekdayName 5] \
         [tical::locale::getWeekdayName 7]
} -result {Montag Freitag Sonntag}

test locale-1.4 {German weekday names short} -setup {
    tical::config::set locale de_DE
} -body {
    list [tical::locale::getWeekdayName 1 short] \
         [tical::locale::getWeekdayName 5 short] \
         [tical::locale::getWeekdayName 7 short]
} -result {Mo Fr So}

test locale-2.1 {English month names} -setup {
    tical::config::set locale en_US
} -body {
    list [tical::locale::getMonthName 1] \
         [tical::locale::getMonthName 10] \
         [tical::locale::getMonthName 12]
} -result {January October December}

test locale-2.2 {English weekday names} -setup {
    tical::config::set locale en_US
} -body {
    list [tical::locale::getWeekdayName 1] \
         [tical::locale::getWeekdayName 5] \
         [tical::locale::getWeekdayName 7]
} -result {Monday Friday Sunday}

test locale-3.1 {French month names} -setup {
    tical::config::set locale fr_FR
} -body {
    list [tical::locale::getMonthName 1] \
         [tical::locale::getMonthName 10] \
         [tical::locale::getMonthName 12]
} -result {Janvier Octobre Décembre}

test locale-3.2 {French weekday names} -setup {
    tical::config::set locale fr_FR
} -body {
    list [tical::locale::getWeekdayName 1 short] \
         [tical::locale::getWeekdayName 5 short] \
         [tical::locale::getWeekdayName 7 short]
} -result {Lu Ve Di}

test locale-4.1 {getMonthNames returns list} -setup {
    tical::config::set locale de_DE
} -body {
    llength [tical::locale::getMonthNames]
} -result 13

test locale-4.2 {getWeekdaysShort returns list} -setup {
    tical::config::set locale de_DE
} -body {
    tical::locale::getWeekdaysShort
} -result {Mo Di Mi Do Fr Sa So}

test locale-4.3 {getWeekdayNames with format 2} -setup {
    tical::config::set locale de_DE
} -body {
    tical::locale::getWeekdayNames 2
} -result {Mo Di Mi Do Fr Sa So}

test locale-5.1 {unknown locale is an error of tical::config::set (1.0.2)} -body {
    list [catch {tical::config::set locale xx_XX} m o] [dict get $o -errorcode] \
         [tical::config::get locale]
} -result {1 {TICAL CONFIG VALUE} de_DE}

test locale-6.1 {getSupportedLocales} -body {
    llength [tical::locale::getSupportedLocales]
} -result 3

test locale-6.2 {getSupportedLanguages} -body {
    tical::locale::getSupportedLanguages
} -result {de en fr}


test locale-5.1 {weekday list rotated to a start day} -setup {
    tical::config::set locale de_DE
} -body {
    list [tical::locale::getWeekdaysShort 7] [tical::locale::getWeekdayNames long 7]
} -result {{So Mo Di Mi Do Fr Sa} {Sonntag Montag Dienstag Mittwoch Donnerstag Freitag Samstag}}

test locale-5.2 {week label long and short} -body {
    set r {}
    foreach l {de_DE en_US fr_FR} {
        tical::config::set locale $l
        lappend r [tical::locale::getWeekLabel] [tical::locale::getWeekLabel short]
    }
    tical::config::set locale de_DE
    set r
} -result {KW KW Week Wk Semaine Sem}

test locale-5.3 {invalid start day: errorcode} -body {
    catch {tical::locale::getWeekdaysShort 0} m opt
    list $m [dict get $opt -errorcode]
} -result {{startDow must be an integer 1..7, got "0"} {TICAL LOCALE DOW}}

test locale-5.4 {config: unknown key, errorcode} -body {
    catch {tical::config::get nix} m opt
    list $m [dict get $opt -errorcode]
} -result {{unknown key: nix} {TICAL CONFIG KEY}}

test locale-9.1 {month, weekday and format are checked (1.0.2)} -body {
    ::set r {}
    foreach c {{getMonthName 13} {getMonthName 0} {getWeekdayName 8} {getMonthNames xyz} {getWeekdayNames xyz}} {
        catch {tical::locale::[lindex $c 0] {*}[lrange $c 1 end]} m o
        lappend r [lindex [dict get $o -errorcode] 2]
    }
    lappend r [tical::locale::getMonthName 05] [tical::locale::getWeekdayName 07 short]
} -setup {
    ::set old [tical::config::get locale]
    tical::config::set locale de_DE
} -cleanup {
    tical::config::set locale $old
} -result {MONTH MONTH DOW FORMAT FORMAT Mai So}

test locale-10.1 {pkgIndex loads the files as UTF-8 whatever the system encoding} -body {
    # child process with a non-UTF-8 system encoding where a locale decides
    # it (Windows: cp1252 anyway); before, 8.6 read "März" as "MÃ¤rz"
    set root [file normalize [file dirname [info script]]/..]
    set f [file join [temporaryDirectory] locale-101-[pid].tcl]
    set h [open $f w]
    puts $h [list lappend auto_path $root]
    puts $h {package require tical::config; package require tical::locale}
    puts $h {tical::config::set locale de_DE}
    puts $h {set m [tical::locale::getMonthName 3]}
    puts $h {puts "[string length $m] [scan [string index $m 1] %c]"}
    close $h
    set saved [array get ::env]
    set ::env(LC_ALL) C
    unset -nocomplain ::env(LANG)
    set r [exec [info nameofexecutable] $f]
    array unset ::env; array set ::env $saved
    file delete $f
    set r
} -result {4 228}

cleanupTests

