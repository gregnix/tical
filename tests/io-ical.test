package require tcltest
lappend auto_path [file normalize [file dirname [info script]]/..]
package require tical::io::ical

namespace import tcltest::*

test export-1.1 {Minimal VEVENT ohne RRULE} -body {
    ::set event [tical::io::ical::makeEvent \
        -dtstart "20251014T090000Z" \
        -dtend "20251014T100000Z" \
        -summary "Test Meeting"]
    
    ::set ics [tical::io::ical::exportEvents [list $event]]
    
    ::set checks {}
    lappend checks [expr {[string match "*BEGIN:VCALENDAR*" $ics]}]
    lappend checks [expr {[string match "*VERSION:2.0*" $ics]}]
    lappend checks [expr {[string match "*BEGIN:VEVENT*" $ics]}]
    lappend checks [expr {[string match "*DTSTART:20251014T090000Z*" $ics]}]
    lappend checks [expr {[string match "*DTEND:20251014T100000Z*" $ics]}]
    lappend checks [expr {[string match "*SUMMARY:Test Meeting*" $ics]}]
    lappend checks [expr {[string match "*END:VEVENT*" $ics]}]
    lappend checks [expr {[string match "*END:VCALENDAR*" $ics]}]
    lappend checks [expr {[string match "*\r\n*" $ics]}]
    
    expr {[lsearch $checks 0] == -1}
} -result 1

test export-1.2 {Escaping von Sonderzeichen} -body {
    ::set event [tical::io::ical::makeEvent \
        -dtstart "20251014T090000Z" \
        -dtend "20251014T100000Z" \
        -summary "Test; Meeting, with\\special\nchars"]
    
    ::set ics [tical::io::ical::exportEvents [list $event]]
    
    ::set checks {}
    lappend checks [expr {[string match "*SUMMARY:Test\\\\; Meeting\\\\, with\\\\\\\\special\\\\nchars*" $ics]}]
    
    expr {[lsearch $checks 0] == -1}
} -result 1

test export-1.3 {RRULE FREQ=DAILY mit COUNT} -body {
    ::set event [tical::io::ical::makeEvent \
        -dtstart "20251014T090000Z" \
        -dtend "20251014T100000Z" \
        -summary "Daily Standup" \
        -rrule [dict create freq DAILY count 5]]
    
    ::set ics [tical::io::ical::exportEvents [list $event]]
    
    ::set checks {}
    lappend checks [expr {[string match "*RRULE:FREQ=DAILY;COUNT=5*" $ics]}]
    
    expr {[lsearch $checks 0] == -1}
} -result 1

test export-1.4 {RRULE FREQ=WEEKLY mit UNTIL} -body {
    ::set event [tical::io::ical::makeEvent \
        -dtstart "20251014T090000Z" \
        -dtend "20251014T100000Z" \
        -summary "Weekly Review" \
        -rrule [dict create freq WEEKLY until "20251231T235959Z"]]
    
    ::set ics [tical::io::ical::exportEvents [list $event]]
    
    ::set checks {}
    lappend checks [expr {[string match "*RRULE:FREQ=WEEKLY;UNTIL=20251231T235959Z*" $ics]}]
    
    expr {[lsearch $checks 0] == -1}
} -result 1

test export-1.5 {RRULE FREQ=MONTHLY mit INTERVAL} -body {
    ::set event [tical::io::ical::makeEvent \
        -dtstart "20251014T090000Z" \
        -dtend "20251014T100000Z" \
        -summary "Monthly Report" \
        -rrule [dict create freq MONTHLY interval 2 count 3]]
    
    ::set ics [tical::io::ical::exportEvents [list $event]]
    
    ::set checks {}
    lappend checks [expr {[string match "*RRULE:FREQ=MONTHLY;COUNT=3;INTERVAL=2*" $ics]}]
    
    expr {[lsearch $checks 0] == -1}
} -result 1

test export-1.6 {Validierungsfehler: dtend fehlt} -body {
    ::set event [tical::io::ical::makeEvent \
        -dtstart "20251014T100000Z" \
        -summary "No End Time"]
    
    ::set ics [tical::io::ical::exportEvents [list $event]]
    
    expr {[string match "*DTSTART:20251014T100000Z*" $ics] && ![string match "*DTEND:*" $ics]}
} -result 1

test export-1.7 {Mehrere Events} -body {
    ::set events [list \
        [tical::io::ical::makeEvent \
            -dtstart "20251014T090000Z" \
            -dtend "20251014T100000Z" \
            -summary "Event 1"] \
        [tical::io::ical::makeEvent \
            -dtstart "20251015T140000Z" \
            -dtend "20251015T150000Z" \
            -summary "Event 2"]]
    
    ::set ics [tical::io::ical::exportEvents $events]
    
    ::set count 0
    foreach line [split $ics "\n"] {
        if {[string match "*BEGIN:VEVENT*" $line]} {
            incr count
        }
    }
    
    ::set count
} -result 2

test export-1.8 {Optionale Felder: description und location} -body {
    ::set event [tical::io::ical::makeEvent \
        -dtstart "20251014T090000Z" \
        -dtend "20251014T100000Z" \
        -summary "Meeting" \
        -description "Important meeting about project X" \
        -location "Conference Room A"]
    
    ::set ics [tical::io::ical::exportEvents [list $event]]
    
    ::set checks {}
    lappend checks [expr {[string match "*DESCRIPTION:Important meeting about project X*" $ics]}]
    lappend checks [expr {[string match "*LOCATION:Conference Room A*" $ics]}]
    
    expr {[lsearch $checks 0] == -1}
} -result 1

test export-1.9 {RRULE mit BYDAY} -body {
    ::set event [tical::io::ical::makeEvent \
        -dtstart "20251014T100000Z" \
        -dtend "20251014T110000Z" \
        -summary "Fitness Training" \
        -rrule [dict create freq WEEKLY byday {MO WE FR} count 12]]
    
    ::set ics [tical::io::ical::exportEvents [list $event]]
    
    expr {[string match "*RRULE:FREQ=WEEKLY;COUNT=12;BYDAY=MO,WE,FR*" $ics]}
} -result 1

test export-1.10 {EXDATE - Mehrere Ausnahmen} -body {
    ::set event [dict create \
        uid "test@tical" \
        dtstamp "20251014T120000Z" \
        dtstart "20251014T090000Z" \
        dtend "20251014T100000Z" \
        summary "Daily Meeting" \
        rrule [dict create freq DAILY count 5] \
        exdate [list "20251016T090000Z" "20251018T090000Z"]]
    
    ::set ics [tical::io::ical::exportEvents [list $event]]
    
    ::set checks {}
    lappend checks [expr {[string match "*EXDATE:20251016T090000Z*" $ics]}]
    lappend checks [expr {[string match "*EXDATE:20251018T090000Z*" $ics]}]
    
    expr {[lsearch $checks 0] == -1}
} -result 1

test export-1.11 {CATEGORIES und STATUS} -body {
    ::set event [tical::io::ical::makeEvent \
        -dtstart "20251014T140000Z" \
        -dtend "20251014T150000Z" \
        -summary "Project Review" \
        -status "CONFIRMED" \
        -categories [list "Work" "Project"]]
    
    ::set ics [tical::io::ical::exportEvents [list $event]]
    
    ::set checks {}
    lappend checks [expr {[string match "*STATUS:CONFIRMED*" $ics]}]
    lappend checks [expr {[string match "*CATEGORIES:Work,Project*" $ics]}]
    
    expr {[lsearch $checks 0] == -1}
} -result 1

test export-1.12 {makeEvent Convenience-Funktion} -body {
    ::set event [tical::io::ical::makeEvent \
        -dtstart "20251014T090000Z" \
        -summary "Test"]
    
    ::set checks {}
    lappend checks [dict exists $event uid]
    lappend checks [dict exists $event dtstamp]
    lappend checks [expr {[dict get $event dtstart] eq "20251014T090000Z"}]
    lappend checks [expr {[dict get $event summary] eq "Test"}]
    
    expr {[lsearch $checks 0] == -1}
} -result 1

test export-2.1 {exportToFile writes plain CRLF (no CR CR LF)} -setup {
    ::set fn [tcltest::makeFile {} tical-export-2.1.ics]
} -body {
    tical::io::ical::exportToFile [list [tical::io::ical::makeEvent \
        -dtstart 20251014T090000Z -summary Test]] $fn
    ::set ch [open $fn rb]; ::set data [read $ch]; close $ch
    list [string first "\r\r" $data] [string match "BEGIN:VCALENDAR\r\nVERSION:2.0\r\n*" $data]
} -cleanup {
    tcltest::removeFile tical-export-2.1.ics
} -result {-1 1}

test export-2.2 {an invalid event leaves an existing file as it was} -setup {
    ::set fn [tcltest::makeFile {} tical-export-2.2.ics]
    ::set ch [open $fn wb]; puts -nonewline $ch "PRECIOUS DATA"; close $ch
    ::set before [llength [chan names file*]]
} -body {
    ::set rc [catch {tical::io::ical::exportToFile \
        [list {uid u1 dtstart kaputt summary S}] $fn}]
    ::set ch [open $fn rb]; ::set data [read $ch]; close $ch
    list $rc $data [expr {[llength [chan names file*]] - $before}] \
        [llength [glob -nocomplain $fn.tmp*]]
} -cleanup {
    tcltest::removeFile tical-export-2.2.ics
} -result {1 {PRECIOUS DATA} 0 0}


test validate-1.1 {local time (no Z) is valid} -body {
    tical::io::ical::validate {uid u1 dtstart 20251014T090000 summary S}
} -result 1

test validate-1.2 {UTC time is valid, dtend checked too} -body {
    tical::io::ical::validate {uid u1 dtstart 20251014T090000Z dtend 20251014T100000Z summary S}
} -result 1

test validate-2.1 {missing field: English message, errorcode} -body {
    catch {tical::io::ical::validate {uid u1 summary S}} m opt
    list $m [dict get $opt -errorcode]
} -result {{event missing required field: dtstart} {TICAL ICAL FIELD}}

test validate-2.2 {message names the formats that are allowed} -body {
    catch {tical::io::ical::validate {uid u1 dtstart 2025101 summary S}} m opt
    list $m [dict get $opt -errorcode]
} -result {{dtstart format invalid: "2025101" (expected YYYYMMDD, YYYYMMDDTHHMMSS or YYYYMMDDTHHMMSSZ)} {TICAL ICAL FORMAT}}

test validate-1.3 {date (all-day) is valid, dtend exclusive} -body {
    tical::io::ical::validate {uid u1 dtstart 20251014 dtend 20251015 summary S}
} -result 1

test validate-2.6 {date and date-time mixed} -body {
    catch {tical::io::ical::validate {uid u1 dtstart 20251014 dtend 20251014T100000 summary S}} m opt
    list $m [dict get $opt -errorcode]
} -result {{dtstart and dtend must both be dates (YYYYMMDD) or both date-times} {TICAL ICAL FORMAT}}

test validate-2.7 {dtend before dtstart} -body {
    catch {tical::io::ical::validate {uid u1 dtstart 20251014T100000Z dtend 20251014T090000Z summary S}} m opt
    list $m [dict get $opt -errorcode]
} -result {{dtend "20251014T090000Z" is before dtstart "20251014T100000Z"} {TICAL ICAL RANGE}}

test validate-2.3 {dtend message names the formats too} -body {
    catch {tical::io::ical::validate {uid u1 dtstart 20251014T090000Z dtend 2025-10-14 summary S}} m opt
    list $m [dict get $opt -errorcode]
} -result {{dtend format invalid: "2025-10-14" (expected YYYYMMDD, YYYYMMDDTHHMMSS or YYYYMMDDTHHMMSSZ)} {TICAL ICAL FORMAT}}

test validate-2.4 {rrule is checked like on export} -body {
    catch {tical::io::ical::validate {uid u1 dtstart 20251014T090000Z summary S rrule {freq HOURLY}}} m opt
    list $m [dict get $opt -errorcode]
} -result {{FREQ must be DAILY|WEEKLY|MONTHLY|YEARLY, got "HOURLY"} {TICAL ICAL RRULE}}

test validate-2.5 {COUNT and UNTIL together} -body {
    catch {tical::io::ical::validate {uid u1 dtstart 20251014T090000Z summary S rrule {freq DAILY count 2 until 20251231T000000Z}}} m opt
    list $m [dict get $opt -errorcode]
} -result {{RRULE cannot have both COUNT and UNTIL} {TICAL ICAL RRULE}}

test ical-iso-1 {ICalToISO8601: English message} -body {
    catch {tical::io::ical::ICalToISO8601 2025} m opt
    list $m [dict get $opt -errorcode]
} -result {{invalid iCalendar date-time: "2025" (expected YYYYMMDDTHHMMSS or YYYYMMDDTHHMMSSZ)} {TICAL ICAL FORMAT}}

test fold-1.1 {folding counts UTF-8 octets, max 75 per line} -body {
    ::set ev [tical::io::ical::makeEvent -uid u1 -dtstart 20251014T090000Z \
        -summary [string repeat \u00e4 60]]
    ::set max 0
    foreach l [split [tical::io::ical::exportEvents [list $ev]] \n] {
        ::set l [string trimright $l \r]
        ::set b [string length [encoding convertto utf-8 $l]]
        if {$b > $max} { ::set max $b }
    }
    expr {$max <= 75 && $max >= 74}
} -result 1

test fold-1.2 {unfolding gives the original line} -body {
    ::set text "[string repeat \u00e4b 40] Ende"
    ::set f [tical::io::ical::FoldLine "SUMMARY:$text"]
    string equal [string map [list "\r\n " ""] $f] "SUMMARY:$text"
} -result 1


# lines of a VEVENT without DTSTAMP
proc veventLines {ics} {
    ::set out {}
    foreach l [split [string map {"\r\n" "\n"} $ics] \n] {
        if {[string match DTSTAMP:* $l] || [string match UID:* $l]} continue
        lappend out $l
    }
    join [lrange $out [lsearch $out BEGIN:VEVENT] [lsearch $out END:VEVENT]] " "
}

test allday-1.1 {all-day event: VALUE=DATE, DTEND exclusive} -body {
    veventLines [tical::io::ical::exportEvents [list \
        [tical::io::ical::makeEvent -dtstart 20251020 -dtend 20251023 -summary Messe]]]
} -result {BEGIN:VEVENT DTSTART;VALUE=DATE:20251020 DTEND;VALUE=DATE:20251023 SUMMARY:Messe END:VEVENT}

test allday-1.2 {ISO date and allday 1 are written as VALUE=DATE} -body {
    veventLines [tical::io::ical::exportEvents [list \
        {uid u1 summary Urlaub dtstart 2025-10-20T00:00 dtend 2025-10-24T00:00 allday 1}]]
} -result {BEGIN:VEVENT DTSTART;VALUE=DATE:20251020 DTEND;VALUE=DATE:20251025 SUMMARY:Urlaub END:VEVENT}

test allday-1.3 {EXDATE of an all-day series} -body {
    ::set ics [tical::io::ical::exportEvents [list {uid u1 summary Sport dtstart 20251014
        rrule {freq WEEKLY count 4} exdate {2025-10-21}}]]
    list [string match "*EXDATE;VALUE=DATE:20251021*" $ics] [string match "*RRULE:FREQ=WEEKLY;COUNT=4*" $ics]
} -result {1 1}

test export-3.1 {older field names (tical::model, adapter::sqlite) are exported} -body {
    ::set a [veventLines [tical::io::ical::exportEvents [list \
        {id appt-1 title Meeting date 2025-10-14 startTime 09:00 endTime 10:00}]]]
    ::set b [veventLines [tical::io::ical::exportEvents [list \
        {uid s1 summary Sync starts_at 20251014T090000Z ends_at 20251014T093000Z}]]]
    list $a $b
} -result {{BEGIN:VEVENT DTSTART:20251014T090000 DTEND:20251014T100000 SUMMARY:Meeting END:VEVENT} {BEGIN:VEVENT DTSTART:20251014T090000Z DTEND:20251014T093000Z SUMMARY:Sync END:VEVENT}}

test export-3.2 {RRULE string and BYMONTH/BYMONTHDAY are written} -body {
    ::set ics [tical::io::ical::exportEvents [list {uid u1 summary Zahltag dtstart 20251031
        rrule FREQ=MONTHLY;BYMONTHDAY=-1;COUNT=3}]]
    string match "*RRULE:FREQ=MONTHLY;COUNT=3;BYMONTHDAY=-1*" $ics
} -result 1

test export-3.3 {PRODID names 1.1.1} -body {
    string match "*PRODID:-//tical//tical 1.1.1//EN*" [tical::io::ical::exportEvents {}]
} -result 1

test export-3.4 {tzid: TZID parameter on local times, IANA name; not on UTC or dates} -body {
    ::set out [tical::io::ical::exportEvents [list \
        {uid a summary A dtstart 20251014T090000 dtend 20251014T100000 tzid {W. Europe Standard Time}} \
        {uid b summary B dtstart 20251014T090000Z tzid Europe/Berlin} \
        {uid c summary C dtstart 20251014 tzid Europe/Berlin} \
        {uid d summary D dtstart 20251014T090000 tzid {Custom Zone}}]]
    lsearch -all -inline -regexp [split $out \r\n] {^DTSTART|^DTEND}
} -result {{DTSTART;TZID=Europe/Berlin:20251014T090000} {DTEND;TZID=Europe/Berlin:20251014T100000} DTSTART:20251014T090000Z {DTSTART;VALUE=DATE:20251014} {DTSTART;TZID=Custom Zone:20251014T090000}}

test export-3.5 {UNTIL in UTC when DTSTART has a TZID; floating series unchanged} -body {
    ::set a [tical::io::ical::exportEvents {{uid a summary A dtstart 20251014T090000 tzid Europe/Berlin
        rrule {freq DAILY until 20251020T090000}}}]
    ::set b [tical::io::ical::exportEvents {{uid b summary B dtstart 20251014T090000 tzid Europe/Berlin
        rrule {freq DAILY until 20251020}}}]
    ::set c [tical::io::ical::exportEvents {{uid c summary C dtstart 20251014T090000
        rrule {freq DAILY until 20251020T090000}}}]
    lmap o [list $a $b $c] {lsearch -inline -glob [split $o \r\n] RRULE*}
} -result {{RRULE:FREQ=DAILY;UNTIL=20251020T070000Z} {RRULE:FREQ=DAILY;UNTIL=20251020T215959Z} {RRULE:FREQ=DAILY;UNTIL=20251020T090000}}

test export-3.6 {STATUS checked and written upper case; UID escaped} -body {
    ::set out [tical::io::ical::exportEvents {{uid "a;b" summary A dtstart 20251014 status tentative}}]
    list [lsearch -inline -glob [split $out \r\n] STATUS*] [lsearch -inline -glob [split $out \r\n] UID*] \
         [catch {tical::io::ical::exportEvents {{uid a summary A dtstart 20251014 status foo}}} m o] \
         [dict get $o -errorcode] \
         [catch {tical::io::ical::validate {uid a summary A dtstart 20251014 status foo}}]
} -result {STATUS:TENTATIVE {UID:a\;b} 1 {TICAL ICAL STATUS} 1}

test export-3.7 {recurrence-id written as RECURRENCE-ID (TZID, VALUE=DATE, UTC)} -body {
    ::set out [tical::io::ical::exportEvents [list \
        {uid a summary A dtstart 20251021T200000 recurrence-id 20251021T180000 tzid Europe/Berlin} \
        {uid b summary B dtstart 20251022 recurrence-id 20251021} \
        {uid c summary C dtstart 20251021T090000Z recurrence-id 2025-10-21T08:00Z}]]
    lsearch -all -inline -glob [split $out \r\n] RECURRENCE-ID*
} -result {{RECURRENCE-ID;TZID=Europe/Berlin:20251021T180000} {RECURRENCE-ID;VALUE=DATE:20251021} RECURRENCE-ID:20251021T080000Z}

cleanupTests

