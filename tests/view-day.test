package require tcltest

set rootDir [file dirname [file dirname [file normalize [info script]]]]
lappend auto_path $rootDir

package require tical::view::day 1.0

namespace import ::tcltest::*

test day-basic-1 {Day view with date} -body {
    set spec [tical::view::day::getData -date 2025-10-14]
    list [dict get $spec type] [dict get $spec date]
} -result {day-grid 2025-10-14}

test day-hours-24 {Day view has 24 hours by default} -body {
    set spec [tical::view::day::getData -date 2025-10-14]
    dict get $spec hours
} -result 24

test day-cells-24 {Day view has 24 cells} -body {
    set spec [tical::view::day::getData -date 2025-10-14]
    llength [dict get $spec cells]
} -result 24

test day-hour-range {Day view with custom hour range} -body {
    set spec [tical::view::day::getData -date 2025-10-14 -hourStart 8 -hourEnd 17]
    dict get $spec hours
} -result 10

test day-metadata {Day view includes year, month, day, dow, week} -body {
    set spec [tical::view::day::getData -date 2025-10-14]
    list \
        [dict get $spec year] \
        [dict get $spec month] \
        [dict get $spec day] \
        [dict get $spec dow] \
        [dict get $spec week]
} -result {2025 10 14 2 42}

test day-first-cell {First cell is hour 0 with time 00:00} -body {
    set spec [tical::view::day::getData -date 2025-10-14]
    set cells [dict get $spec cells]
    set firstCell [lindex $cells 0]
    list [dict get $firstCell hour] [dict get $firstCell time]
} -result {0 00:00}

test day-last-cell {Last cell is hour 23 with time 23:00} -body {
    set spec [tical::view::day::getData -date 2025-10-14]
    set cells [dict get $spec cells]
    set lastCell [lindex $cells 23]
    list [dict get $lastCell hour] [dict get $lastCell time]
} -result {23 23:00}

test day-validate {Validate correct ViewSpec} -body {
    set spec [tical::view::day::getData -date 2025-10-14]
    tical::view::day::validate $spec
} -result 1

test day-error-args {missing -date: English message, errorcode} -body {
    catch {tical::view::day::getData} m opt
    list $m [dict get $opt -errorcode]
} -result {{view::day::getData: -date is required} {TICAL VIEW ARGS}}

test day-error-spec {validate: missing field} -body {
    catch {tical::view::day::validate {type day-grid}} m opt
    list $m [dict get $opt -errorcode]
} -result {{ViewSpec missing field: date} {TICAL VIEW SPEC}}


test view-day-5.1 {unknown option: error} -body {
    catch {tical::view::day::getData -date 2025-10-14 -hours 8} m opt
    list $m [dict get $opt -errorcode]
} -result {{view::day::getData: unknown option "-hours", must be -date, -events, -holidays, -hourEnd, -hourStart or -tz} {TICAL VIEW OPTION}}

test view-day-5.2 {-hourStart out of range} -body {
    catch {tical::view::day::getData -date 2025-10-14 -hourStart 25} m opt
    list $m [dict get $opt -errorcode]
} -result {{view::day::getData: -hourStart must be an integer 0..23, got "25"} {TICAL VIEW OPTION}}

test view-day-6.1 {-events: day list and hour cells} -body {
    ::set s [tical::view::day::getData -date 2025-10-14 -tz UTC -hourStart 8 -hourEnd 12 -events {
        {summary Ganztag dtstart 2025-10-14}
        {summary Meeting dtstart 2025-10-14T09:30 dtend 2025-10-14T11:00}
        {summary Kurz dtstart 2025-10-14T12:15}
        {summary Morgen dtstart 2025-10-15T09:00}
    }]
    list [lmap e [dict get $s events] {dict get $e summary}] \
         [lmap c [dict get $s cells] {lmap e [dict get $c events] {list [dict get $e summary] [dict get $e part] [dict get $e time]}}]
} -result {{Ganztag Meeting Kurz} {{} {{Meeting start 09:30}} {{Meeting end {}}} {} {{Kurz single 12:15}}}}

test view-day-6.2 {-events: event from the day before ends in the morning} -body {
    ::set s [tical::view::day::getData -date 2025-10-15 -tz UTC -hourStart 0 -hourEnd 3 -events {
        {summary Nacht dtstart 2025-10-14T22:00 dtend 2025-10-15T02:00}
    }]
    list [lmap e [dict get $s events] {dict get $e part}] \
         [lmap c [dict get $s cells] {lmap e [dict get $c events] {dict get $e part}}]
} -result {end {middle end {} {}}}

cleanupTests


