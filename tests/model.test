package require tcltest

set rootDir [file dirname [file dirname [file normalize [info script]]]]
lappend auto_path $rootDir

package require tical::model 1.1

namespace import ::tcltest::*

test model-create-appointment {Create appointment} -body {
    tical::model::clearAll
    set id [tical::model::createAppointment -title "Meeting" -date 2025-10-14 -startTime "10:00" -endTime "11:00"]
    string match "appt-*" $id
} -result 1

test model-get-appointment {Get appointment} -body {
    tical::model::clearAll
    set id [tical::model::createAppointment -title "Meeting" -date 2025-10-14]
    set appt [tical::model::getAppointment $id]
    dict get $appt title
} -result "Meeting"

test model-update-appointment {Update appointment} -body {
    tical::model::clearAll
    set id [tical::model::createAppointment -title "Meeting" -date 2025-10-14]
    tical::model::updateAppointment $id -title "Updated Meeting"
    set appt [tical::model::getAppointment $id]
    dict get $appt title
} -result "Updated Meeting"

test model-delete-appointment {Delete appointment} -body {
    tical::model::clearAll
    set id [tical::model::createAppointment -title "Meeting" -date 2025-10-14]
    tical::model::deleteAppointment $id
    catch {tical::model::getAppointment $id} err
    string match "*not found*" $err
} -result 1

test model-list-appointments {List all appointments} -body {
    tical::model::clearAll
    set id1 [tical::model::createAppointment -title "Meeting 1" -date 2025-10-14]
    set id2 [tical::model::createAppointment -title "Meeting 2" -date 2025-10-15]
    set list [tical::model::listAppointments]
    expr {[llength $list] == 4}
} -result 1

test model-appointments-by-date {Get appointments by date} -body {
    tical::model::clearAll
    set id1 [tical::model::createAppointment -title "Meeting 1" -date 2025-10-14]
    set id2 [tical::model::createAppointment -title "Meeting 2" -date 2025-10-14]
    set id3 [tical::model::createAppointment -title "Meeting 3" -date 2025-10-15]
    set list [tical::model::getAppointmentsByDate 2025-10-14]
    expr {[llength $list] == 4}
} -result 1

test model-create-event {Create event} -body {
    tical::model::clearAll
    set id [tical::model::createEvent -title "Birthday" -date 2025-10-14 -category "personal"]
    string match "evt-*" $id
} -result 1

test model-get-event {Get event} -body {
    tical::model::clearAll
    set id [tical::model::createEvent -title "Birthday" -date 2025-10-14]
    set evt [tical::model::getEvent $id]
    dict get $evt title
} -result "Birthday"

test model-list-events {List all events} -body {
    tical::model::clearAll
    set id1 [tical::model::createEvent -title "Event 1" -date 2025-10-14]
    set id2 [tical::model::createEvent -title "Event 2" -date 2025-10-15]
    set list [tical::model::listEvents]
    expr {[llength $list] == 4}
} -result 1

test model-clear-all {Clear all appointments and events} -body {
    tical::model::clearAll
    set id1 [tical::model::createAppointment -title "Meeting" -date 2025-10-14]
    set id2 [tical::model::createEvent -title "Event" -date 2025-10-14]
    tical::model::clearAll
    expr {[llength [tical::model::listAppointments]] == 0 && [llength [tical::model::listEvents]] == 0}
} -result 1

test model-error-1 {missing -title/-date} -body {
    catch {tical::model::createAppointment -title x} m opt
    list $m [dict get $opt -errorcode]
} -result {{appointment requires -summary and -dtstart (or -title and -date)} {TICAL MODEL ARGS}}

test model-error-2 {unknown event id} -body {
    catch {tical::model::getEvent evt-0} m opt
    list $m [dict get $opt -errorcode]
} -result {{event not found: evt-0} {TICAL MODEL NOTFOUND}}


test model-2.1 {new options: record in the event format plus the 1.0.1 fields} -body {
    tical::model::clearAll
    ::set id [tical::model::createAppointment -summary Review -dtstart 2025-10-15T14:00 \
        -dtend 2025-10-15T15:30 -location B2]
    ::set a [tical::model::getAppointment $id]
    list {*}[lmap k {summary dtstart dtend allday title date startTime endTime} {dict get $a $k}] \
        [string equal [dict get $a uid] $id]
} -result {Review 20251015T140000 20251015T153000 0 Review 2025-10-15 14:00 15:30 1}

test model-2.2 {old options give the same record} -body {
    tical::model::clearAll
    ::set id [tical::model::createAppointment -title Review -date 2025-10-15 \
        -startTime 14:00 -endTime 15:30]
    ::set a [tical::model::getAppointment $id]
    lmap k {summary dtstart dtend allday} {dict get $a $k}
} -result {Review 20251015T140000 20251015T153000 0}

test model-2.3 {event without time is all-day} -body {
    tical::model::clearAll
    ::set id [tical::model::createEvent -title Geburtstag -date 2025-10-14 -category privat]
    ::set e [tical::model::getEvent $id]
    lmap k {summary dtstart allday categories allDay category} {dict get $e $k}
} -result {Geburtstag 20251014 1 privat 1 privat}

test model-2.4 {update with old and new field names} -body {
    tical::model::clearAll
    ::set id [tical::model::createAppointment -title M -date 2025-10-14 -startTime 09:00]
    tical::model::updateAppointment $id -date 2025-10-16
    ::set r [dict get [tical::model::getAppointment $id] dtstart]
    tical::model::updateAppointment $id -summary N -dtstart 2025-10-17T08:00
    ::set a [tical::model::getAppointment $id]
    list $r [dict get $a dtstart] [dict get $a date] [dict get $a title]
} -result {20251016T090000 20251017T080000 2025-10-17 N}

test model-2.5 {toEvents: event dicts for the views} -body {
    tical::model::clearAll
    tical::model::createAppointment -title M -date 2025-10-14 -startTime 09:00
    tical::model::createEvent -summary Messe -dtstart 2025-10-20 -dtend 2025-10-23
    regsub -all {(appt|evt)-\d+} [tical::model::toEvents] {\1-N}
} -result {{summary M dtstart 20251014T090000 allday 0 uid appt-N} {summary Messe dtend 20251023 dtstart 20251020 allday 1 uid evt-N color {}}}

test model-2.6 {toEvents feeds getData -events} -body {
    package require tical::view::month 1.1
    tical::model::clearAll
    tical::model::createAppointment -title M -date 2025-10-14 -startTime 09:00
    ::set s [tical::view::month::getData -year 2025 -month 10 -events [tical::model::toEvents]]
    llength [dict get [lindex [dict get $s cells] 15] events]
} -result 1

test model-9.1 {unknown option and missing value are errors (1.1.1)} -body {
    tical::model::clearAll
    ::set id [tical::model::createAppointment -summary A -dtstart 2025-10-14T09:00]
    ::set r {}
    foreach a {{-sumary B} {-summary}} {
        catch {tical::model::updateAppointment $id {*}$a} m o
        lappend r [dict get $o -errorcode]
    }
    catch {tical::model::createAppointment -summary C -dtstart 2025-10-14 -loction X} m o
    lappend r [dict get $o -errorcode] [dict get [tical::model::getAppointment $id] summary]
} -result {{TICAL MODEL OPTION} {TICAL MODEL OPTION} {TICAL MODEL OPTION} A}

test model-9.2 {update of status and categories now applies} -body {
    tical::model::clearAll
    ::set id [tical::model::createAppointment -summary A -dtstart 2025-10-14T09:00]
    tical::model::updateAppointment $id -status CONFIRMED -location Raum
    ::set a [tical::model::getAppointment $id]
    list [dict get $a status] [dict get $a location]
} -result {CONFIRMED Raum}

test model-10.1 {-tzid is kept; legacy date/time in the display zone (1.1.1)} -setup {
    tical::model::clearAll
} -body {
    set id [tical::model::createEvent -summary NY -dtstart 20251014T090000 \
        -dtend 20251014T100000 -tzid America/New_York]
    set ev [tical::model::getEvent $id]
    set a [tical::model::createAppointment -summary A -dtstart 20251014T090000 -tzid Europe/Berlin]
    tical::model::updateAppointment $a -tzid America/New_York
    set ap [tical::model::getAppointment $a]
    list [dict get $ev tzid] [dict get [lindex [tical::model::toEvents] end] tzid] \
        [dict get $ap tzid] [string length [dict get $ap startTime]]
} -cleanup {
    tical::model::clearAll
} -result {America/New_York America/New_York America/New_York 5}

cleanupTests


