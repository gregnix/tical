package require tcltest
lappend auto_path [file normalize [file dirname [info script]]/..]
package require tical::core 1.0

namespace import tcltest::*

test core-1.1 {ISO week sanity} -body {
    ::set d [tical::core::calendarData -year 2025 -month 10]
    string is integer -strict [dict get [lindex [dict get $d days] 0] week]
} -result 1

test core-1.2 {leap year} -body {
    tical::core::isLeap 2024
} -result 1

test core-2.1 {calendarData without -month} -body {
    catch {tical::core::calendarData -year 2025} m opt
    list $m [dict get $opt -errorcode]
} -result {{calendarData: -year and -month are required} {TICAL CORE ARGS}}


test core-3.1 {weekNumber iso/simple/us} -body {
    lmap d {2025-01-05 2023-01-01 2025-12-31} {
        ::set t [clock scan "$d 12:00:00" -timezone UTC]
        lmap fw {iso simple us} {tical::core::weekNumber $t UTC $fw}
    }
} -result {{1 1 2} {52 1 1} {1 53 53}}

test core-3.2 {weekNumber: bad firstWeek} -body {
    catch {tical::core::weekNumber 0 UTC nix} m opt
    list $m [dict get $opt -errorcode]
} -result {{bad firstWeek "nix": must be iso, simple or us} {TICAL CORE FIRSTWEEK}}

# --- tical::config 1.0.2 ------------------------------------------------------

test config-1.1 {unknown key and bad values are errors; value unchanged} -body {
    ::set r {}
    foreach {k v} {weekStart sun timezone Mars/Base weekstart sonntag firstweek iso8601
                   theme bunt today 2025-02-30 locale xx_YY} {
        catch {tical::config::set $k $v} m o
        lappend r [lindex [dict get $o -errorcode] 2]
    }
    list $r [tical::config::get weekstart] [tical::config::get timezone]
} -result {{KEY VALUE VALUE VALUE VALUE VALUE VALUE} mon Europe/Berlin}

test config-1.2 {good values: other locale of a known language, monday, :localtime} -body {
    ::set old [list [tical::config::get locale] [tical::config::get weekstart] [tical::config::get timezone]]
    ::set r [list [tical::config::set locale en_GB] [tical::config::set weekstart Monday] \
                  [tical::config::set timezone :localtime]]
    lassign $old l w z
    tical::config::set locale $l; tical::config::set weekstart $w; tical::config::set timezone $z
    ::set r
} -result {en_GB Monday :localtime}

test config-1.3 {today: marks the day in core, month, week and day} -setup {
    tical::config::set today 2025-10-14
    package require tical::view::month; package require tical::view::week; package require tical::view::day
} -body {
    ::set c [lsearch -inline -index 1 [lmap d [dict get [tical::core::calendarData -year 2025 -month 10] days] {list [dict get $d isToday] [dict get $d date]}] 2025-10-14]
    ::set m [lmap x [dict get [tical::view::month::getData -year 2025 -month 10] cells] {
        if {"today" in [dict get $x markers]} { dict get $x date } else continue }]
    ::set w [lmap x [dict get [tical::view::week::getData -date 2025-10-14] cells] {
        if {"today" in [dict get $x markers]} { dict get $x date } else continue }]
    ::set d [dict get [lindex [dict get [tical::view::day::getData -date 2025-10-14] cells] 0] markers]
    list $c $m $w $d [tical::config::today]
} -cleanup {
    tical::config::set today ""
} -result {{1 2025-10-14} 2025-10-14 2025-10-14 today 2025-10-14}

cleanupTests
