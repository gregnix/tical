package require tcltest

set rootDir [file dirname [file dirname [file normalize [info script]]]]
lappend auto_path $rootDir

package require tical::holidays 1.0
package require tical::holidays::de 1.0

namespace import ::tcltest::*

test holidays-de-neujahr {Deutsche Feiertage: Neujahr} -body {
    set holidays [tical::holidays::getHolidays DE 2025 1]
    dict exists $holidays 1
} -result 1

test holidays-de-tagderarbeit {Deutsche Feiertage: Tag der Arbeit} -body {
    set holidays [tical::holidays::getHolidays DE 2025 5]
    dict exists $holidays 1
} -result 1

test holidays-de-einheit {Deutsche Feiertage: Tag der Deutschen Einheit} -body {
    set holidays [tical::holidays::getHolidays DE 2025 10]
    expr {[dict exists $holidays 3] && [dict get $holidays 3] eq "Tag der Deutschen Einheit"}
} -result 1

test holidays-de-weihnachten {Deutsche Feiertage: Weihnachten} -body {
    set holidays [tical::holidays::getHolidays DE 2025 12]
    expr {[dict exists $holidays 25] && [dict exists $holidays 26]}
} -result 1

test holidays-de-ostern {Deutsche Feiertage: Ostermontag 2025} -body {
    set holidays [tical::holidays::getHolidays DE 2025 4]
    dict exists $holidays 21
} -result 1

test holidays-empty-month {Keine Feiertage im Monat} -body {
    set holidays [tical::holidays::getHolidays DE 2025 2]
    llength [dict keys $holidays]
} -result 0

test holidays-markers {Markers Format} -body {
    set markers [tical::holidays::getMarkers DE 2025 10]
    expr {[llength $markers] > 0}
} -result 1

test holidays-region-case {Region key is case-insensitive (de = DE)} -body {
    expr {[tical::holidays::getHolidays de 2025 10] eq [tical::holidays::getHolidays DE 2025 10]
          && [dict size [tical::holidays::getHolidays de 2025 10]] == 1}
} -result 1

# --- -sundays, alignment with tclutils::tuholiday (1.0.1) --------------------

test holidays-de-1.1 {getHolidays: nine nationwide holidays, sorted} -body {
    ::set h [tical::holidays::de::getHolidays 2025]
    list [dict size $h] [expr {[lsort [dict keys $h]] eq [dict keys $h]}] \
         [dict exists $h 2025-04-20] [dict exists $h 2025-06-08]
} -result {9 1 0 0}

test holidays-de-1.2 {-sundays 1 adds Ostersonntag and Pfingstsonntag} -body {
    ::set h [tical::holidays::de::getHolidays -sundays 1 2025]
    list [dict size $h] [dict get $h 2025-04-20] [dict get $h 2025-06-08]
} -result {11 Ostersonntag Pfingstsonntag}

test holidays-de-1.3 {register with -sundays 1: the views see the Sundays} -setup {
    tical::holidays::register DE-SO {::tical::holidays::de::getHolidays -sundays 1}
} -body {
    list [tical::holidays::getHolidays DE-SO 2025 4] [tical::holidays::getHolidays DE 2025 4]
} -result {{18 Karfreitag 20 Ostersonntag 21 Ostermontag} {18 Karfreitag 21 Ostermontag}}

test holidays-de-1.4 {bad option, bad year} -body {
    list [catch {tical::holidays::de::getHolidays -sunday 1 2025} m o1] [dict get $o1 -errorcode] \
         [catch {tical::holidays::de::getHolidays 1500} m o2] [dict get $o2 -errorcode]
} -result {1 {TICAL HOLIDAYS OPTION} 1 {TICAL HOLIDAYS YEAR}}

# tclutils: TCLUTILS_TM or a sibling checkout ../tclutils/lib/tm
if {[info exists ::env(TCLUTILS_TM)]} {
    if {$::env(TCLUTILS_TM) ne ""} { tcl::tm::path add $::env(TCLUTILS_TM) }
} elseif {[file isdirectory [file join [file dirname $rootDir] tclutils lib tm]]} {
    tcl::tm::path add [file join [file dirname $rootDir] tclutils lib tm]
}
testConstraint tuholiday [expr {![catch {package require tclutils::tuholiday 0.1}]}]

test holidays-de-2.1 {-sundays 1 equals tclutils::tuholiday for 2000..2040} -constraints tuholiday -body {
    ::set diff {}
    for {::set y 2000} {$y <= 2040} {incr y} {
        if {[tical::holidays::de::getHolidays -sundays 1 $y] ne [tclutils::tuholiday::holidays $y]} {
            lappend diff $y
        }
    }
    ::set diff
} -result {}

test holidays-de-2.2 {tuholiday can be registered directly} -constraints tuholiday -setup {
    tical::holidays::register DE-TU ::tclutils::tuholiday::holidays
} -body {
    expr {[tical::holidays::getHolidays DE-TU 2025 6] eq [tical::holidays::getHolidays DE-SO 2025 6]}
} -result 1

test holidays-3.1 {month outside 1..12 is an error, also for an unknown region (1.0.2)} -body {
    lmap a {{DE 2025 13} {XX 2025 0} {DE 2025 x}} {
        catch {tical::holidays::getHolidays {*}$a} m o
        dict get $o -errorcode
    }
} -result {{TICAL HOLIDAYS MONTH} {TICAL HOLIDAYS MONTH} {TICAL HOLIDAYS MONTH}}

cleanupTests


